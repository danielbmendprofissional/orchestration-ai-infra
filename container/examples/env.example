# Copiar pra container/.env (fora do git) e preencher SÓ os logins de admin abaixo.
# Senhas de máquina (PG_*, REDIS_*, PROJECT_*) não entram aqui: o
# configs/infra/infra-config.mjs gera na primeira rodada e acrescenta no fim do .env.
# Chaves do OmniRoute: ver configs/omniroute/README.md.

# =================================
# = POSTGRES (superusuário — só você/pgAdmin; projeto nunca usa)
# =================================
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
PGADMIN_DEFAULT_EMAIL=example_email@gmail.com
PGADMIN_DEFAULT_PASSWORD=example_password
# =================================
# = RABBIT (admin da UI http://localhost:15672)
# =================================
RABBITMQ_DEFAULT_USER=example_user
RABBITMQ_DEFAULT_PASS=example_password
# =================================
# = KEYCLOACK (admin do realm master, http://localhost:8080)
# =================================
KEYCLOAK_ADMIN=example_user
KEYCLOAK_ADMIN_PASSWORD=example_password
# =================================
# = OBSERVABILITY (admin do Grafana, http://localhost:3000)
# =================================
GF_SECURITY_ADMIN_USER=example_user
GF_SECURITY_ADMIN_PASSWORD=example_password

# =================================
# = OMNIROUTE (gateway de LLM)
# =================================
OMNIROUTE_INITIAL_PASSWORD=example_password
